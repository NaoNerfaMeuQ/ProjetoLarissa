rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /{folder}/{fileName} {
      allow read: if folder in ['historias', 'capas', 'conteudo'];

      allow create, update: if folder in ['historias', 'capas', 'conteudo']
                            && isAdmin()
                            && request.resource.size > 0
                            && request.resource.size <= 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');

      allow delete: if folder in ['historias', 'capas', 'conteudo'] && isAdmin();
    }
  }
}
